# Sao chép thành file .env rồi chỉnh. File .env được cả run.sh và systemd service đọc.
PORT=5000
HOST=0.0.0.0

# Dùng bản ffmpeg-rockchip đã build (scripts/build-ffmpeg-rockchip.sh)
#FFMPEG_BIN=/usr/local/bin/ffmpeg
#FFPROBE_BIN=/usr/local/bin/ffprobe

# Đường dẫn Piper native (fallback). Ưu tiên piper-tts trong .venv (warm model).
#PIPER_BIN=/opt/piper/piper
# Số synth Piper cùng lúc. Mặc định 1 — song song (kể cả clone thư mục) dễ hard-reboot RK3588.
#PIPER_CONCURRENCY=1
# Thread onnxruntime / OpenMP cho Piper in-process
#PIPER_ORT_THREADS=2
#PIPER_OMP_THREADS=2

# Edge TTS (cloud). Giữ thấp để tránh bị Microsoft throttle -> lỗi
# "No audio was received". Tăng lên nếu mạng khỏe và ít cảnh.
#EDGE_CONCURRENCY=2
# Độ trễ (giây) rải đều các request Edge để tránh dồn dập. 0 = tắt rải.
#EDGE_STAGGER=0.4

# ── ElevenLabs TTS (cloud, cần API key) ─────────────────────────────
# Lấy key: https://elevenlabs.io → Profile → API Keys (free tier dùng được).
#ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Voice ID mặc định khi UI để trống. Xem danh sách: GET /v1/voices
#ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Model đa ngôn ngữ (hỗ trợ tiếng Việt). Turbo: eleven_turbo_v2_5
#ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Số request ElevenLabs song song. Free tier nên để 1.
#ELEVENLABS_CONCURRENCY=1
# Đổi khi dùng endpoint/proxy riêng
#ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Cờ bổ sung cho Chromium (cách nhau bởi dấu cách)
#CHROMIUM_ARGS=
#CHROMIUM_GPU_ARGS="--ignore-gpu-blocklist --enable-gpu-rasterization --use-gl=angle --use-angle=gles"
